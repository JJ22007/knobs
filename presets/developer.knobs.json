{
  "knobs": 1,
  "about": "For people who live in a terminal: fast key repeat, no autocorrect or smart punctuation, every file and path visible.",
  "about.zh": "给整天待在终端里的人:按键重复快、不自动纠错不改标点、文件和路径全都看得见。",
  "settings": {
    "keyboard.repeat": 2,
    "keyboard.repeatDelay": 15,
    "keyboard.pressAndHold": false,
    "keyboard.fullAccess": "2",
    "text.autocorrect": false,
    "text.capitalize": false,
    "text.doubleSpacePeriod": false,
    "text.smartQuotes": false,
    "text.smartDashes": false,
    "text.inlinePrediction": false,
    "finder.extensions": true,
    "finder.hiddenFiles": true,
    "finder.pathBar": true,
    "finder.statusBar": true,
    "finder.pathInTitle": true,
    "finder.foldersFirst": true,
    "finder.view": "Nlsv",
    "finder.searchScope": "SCcf",
    "finder.extensionWarning": false,
    "finder.noNetworkDSStore": true,
    "finder.noUSBDSStore": true,
    "files.expandSavePanel": true,
    "files.saveToICloud": false,
    "screenshots.format": "png",
    "screenshots.shadow": false,
    "windows.dragAnywhere": true,
    "apps.keepWindows": false
  }
}
